# Application Environment & Public URL
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Neon Serverless Postgres Connections (Server-Side Only - NEVER expose to browser)
# 1. DATABASE_URL: Neon POOLED connection string (host contains "-pooler") for app_user role
DATABASE_URL="postgresql://app_user:APP_USER_PASSWORD@ep-xy-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. DATABASE_URL_MIGRATE: Neon DIRECT connection string for neondb_owner role (used strictly by migrations)
DATABASE_URL_MIGRATE="postgresql://neondb_owner:OWNER_PASSWORD@ep-xy.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Server Authentication & Session Secret (32+ cryptographically random bytes)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="your-32-byte-hex-secret-here-replace-with-secure-random-key"

# Transactional Email (Resend)
# Used for email verification, password reset, payment confirmation, and enquiry routing
RESEND_API_KEY="re_test_..."
EMAIL_FROM="Avichas Metrics <noreply@avichasmetrics.com>"

# Internal Maintenance Scheduled Task Secret (Sent via Authorization / x-cron-secret header)
CRON_SECRET="your-secure-internal-cron-secret-here"

# Payments (Paystack - Stage 2)
PAYSTACK_SECRET_KEY="sk_test_..."
